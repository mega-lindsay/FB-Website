# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored — never commit real secrets.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Cloudflare Turnstile (CAPTCHA) ---
# Required. Registration fails closed if this is unset.
# Get it from Cloudflare → Turnstile → your widget → Secret Key.
TURNSTILE_SECRET_KEY=

# --- Meta / Facebook Conversions API ---
# Optional. If unset, server-side CAPI events are skipped (browser pixel still fires).
META_ACCESS_TOKEN=
META_PIXEL_ID=

# --- Neon / Postgres (registration backup + duplicate check) ---
# Optional. If unset, the Postgres backup and duplicate guard are skipped.
# Either variable works; POSTGRES_URL takes precedence.
POSTGRES_URL=
DATABASE_URL=

# --- Zoho CRM (lead submission) ---
# Required for CRM lead capture. Falls back to local OAuth files if unset (local dev only).
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
# Optional — defaults to the hardcoded MCP OAuth token endpoint if unset.
ZOHO_TOKEN_ENDPOINT=
